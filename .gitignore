# User-uploaded content lives outside version control — only the
# directory structure (via .gitkeep) is tracked, not what gets uploaded
# through the app at runtime.
/uploads/products/*
!/uploads/products/.gitkeep
/uploads/sales_orders/*
!/uploads/sales_orders/.gitkeep
/uploads/imports/*
!/uploads/imports/.gitkeep

# Website-integration secrets live outside version control (see includes/integration_settings.php).
/config/integration.local.php
/integration.local.php
