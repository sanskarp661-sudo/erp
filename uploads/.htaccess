# Uploaded files (product images, etc.) must never be executable, even if
# an attacker somehow got a script past the upload validation in code.
# Defense in depth alongside the getimagesize()/MIME checks in
# inventory/product_form.php.

<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php|php[0-9]?|phtml|phar|pl|py|cgi|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
